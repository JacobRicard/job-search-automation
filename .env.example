# Copy to .env and fill in. Never commit .env.

# --- LLM provider (required) ---
# Google Gemini API key. The free tier is fully supported, no credit card required.
# Get a key here: https://aistudio.google.com/apikey
# Free tier limits: 500 requests/day, 15 RPM. The default rate limit below keeps
# you safely under that quota out of the box.
GEMINI_API_KEY=

# Rate limit delay between Gemini requests (ms). Default 5000 (~12 RPM), tuned for
# the free tier. Raise this if you see 429s; lower it if you have a paid key.
GEMINI_RATE_DELAY_MS=5000

# Optional: Sapling AI text detection (used in the voice-check pipeline)
# https://sapling.ai
SAPLING_API_KEY=

# Optional: HuggingFace AI detection (second detector alongside Sapling)
# Free token from https://huggingface.co/settings/tokens — no credit card needed
HUGGINGFACE_API_KEY=

# --- Gmail rejection sync (optional) ---
# Requires an app-specific password: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Disable the in-process IMAP poller entirely (useful if you run sync-rejections manually).
# REJECTION_EMAIL_SYNC_DISABLED=true

# Polling interval for new rejection emails (ms). Default 300000 (5 min).
# REJECTION_EMAIL_POLL_INTERVAL_MS=300000

# Delay before the first sync after dashboard startup (ms). Default 10000 (10 s).
# REJECTION_EMAIL_INITIAL_DELAY_MS=10000

# --- Pipeline config ---
# Data directory. Defaults to ./data — only set this if you want to store data elsewhere.
# DATA_DIR=data
# SQLite directory. Docker Compose sets this to /app/db, a named volume.
# DB_DIR=data

# Dashboard HTTP port and host
DASHBOARD_PORT=3131
# DASHBOARD_HOST=localhost
# DASHBOARD_BASE_URL=http://localhost:3131

# Timezone for log timestamps and date calculations
TZ=America/Los_Angeles

# --- Scoring ---
# Jobs scoring below this threshold are auto-archived after scoring. Default 4.
# AUTO_ARCHIVE_THRESHOLD=4

# --- Company discovery ---
# Number of candidate companies for Gemini to suggest per run. Default 50.
# DISCOVER_CANDIDATE_COUNT=50
# Cache TTL for discovered companies (hours). Default 6.
# DISCOVER_TTL_HOURS=6



# --- Location filter ---
# Comma-separated list of cities/regions to always allow. Empty = allow all.
# Example: LOCATION_FILTER=seattle,bellevue,redmond
LOCATION_FILTER=
# Comma-separated list of cities/regions to always drop. Empty = block none.
LOCATION_BLOCKLIST=

# --- Built In scraper ---
# Subdomain for the Built In regional site (e.g. 'seattle', 'nyc', 'austin').
# Default 'www' hits the nationwide site.
BUILTIN_SUBDOMAIN=www

# --- Logging ---
# Log verbosity: debug | info | warn | error. Default info.
# LOG_LEVEL=info
# Days to keep refresh log files before pruning. Default 30.
# LOG_RETENTION_DAYS=30

# --- Docker worker (docker compose only) ---
# How often the worker container runs the full refresh pipeline (minutes). Default 30.
# REFRESH_INTERVAL_MINUTES=30
