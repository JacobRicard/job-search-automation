# Copy to .env and fill in. Never commit .env.

# =============================================================================
# LLM — Groq (required for scoring pipeline)
# =============================================================================
# Free API key at https://console.groq.com — no credit card required.
# Free tier: ~14,400 requests/day at very high throughput.
GROQ_API_KEY=

# Delay between Groq requests (ms). Default 500ms. Raise if you see 429s.
# GROQ_RATE_DELAY_MS=500

# =============================================================================
# LLM — Gemini (optional — used only for company discovery and market research)
# =============================================================================
# Get a free key at https://aistudio.google.com/apikey
# Free tier limits: 500 requests/day, 15 RPM.
# Leave blank if you only use the core scoring pipeline.
GEMINI_API_KEY=

# Rate limit delay between Gemini requests (ms). Default 4000.
# GEMINI_RATE_DELAY_MS=4000

# =============================================================================
# Email digest (optional — sends a daily ranked job digest via SMTP)
# =============================================================================
# SMTP server settings — compatible with Gmail, Outlook, SendGrid, etc.
SMTP_HOST=
SMTP_PORT=587
# Set SMTP_SECURE=true for port 465 (SSL). Leave false for STARTTLS (587).
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM defaults to SMTP_USER if not set.
# SMTP_FROM=

# Recipient for the daily digest email.
DIGEST_TO=

# Minimum score to include in digest (1-10). Default 6.
# DIGEST_MIN_SCORE=6
# Maximum number of jobs to include. Default 25.
# DIGEST_MAX_JOBS=25
# How many hours back to look for new scored jobs. Default 26 (overlaps daily runs).
# DIGEST_LOOKBACK_HOURS=26

# =============================================================================
# Rejection email sync — Gmail (option 1)
# =============================================================================
# Requires an app-specific password: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# =============================================================================
# Rejection email sync — Outlook / Microsoft 365 (option 2)
# =============================================================================
# Set IMAP_PROVIDER=outlook to use Outlook instead of Gmail.
# Use an app password from https://account.microsoft.com/security
# Enterprise Microsoft 365 accounts require OAuth2 (not supported yet).
# IMAP_PROVIDER=gmail
# IMAP_EMAIL=
# IMAP_APP_PASSWORD=

# Override IMAP host/port/mailbox names (all optional — derived from IMAP_PROVIDER).
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_MAILBOX=
# IMAP_TRASH_MAILBOX=

# Disable the in-process IMAP poller entirely (run sync-rejections manually instead).
# REJECTION_EMAIL_SYNC_DISABLED=true

# Polling interval for new rejection emails (ms). Default 300000 (5 min).
# REJECTION_EMAIL_POLL_INTERVAL_MS=300000

# Delay before the first sync after dashboard startup (ms). Default 10000 (10 s).
# REJECTION_EMAIL_INITIAL_DELAY_MS=10000

# =============================================================================
# JobSpy scraper (optional — scrapes Indeed, LinkedIn, Glassdoor, ZipRecruiter)
# =============================================================================
# Set to true to enable. Requires python-jobspy: pip install python-jobspy
JOBSPY_ENABLED=false

# Path to your jobspy config file. Defaults to DATA_DIR/jobspy-config.json.
# Copy data.example/jobspy-config.json to data/jobspy-config.json and edit it.
# JOBSPY_CONFIG_PATH=

# =============================================================================
# Pipeline config
# =============================================================================
# Data directory. Defaults to ./data
# DATA_DIR=data
# SQLite directory. Docker Compose sets this to /app/db (a named volume).
# DB_DIR=data

# Dashboard HTTP port and host
DASHBOARD_PORT=3131
# DASHBOARD_HOST=localhost
# DASHBOARD_BASE_URL=http://localhost:3131

# Timezone for log timestamps and date calculations
TZ=America/Los_Angeles

# Jobs scoring below this threshold are auto-archived after scoring. Default 4.
# AUTO_ARCHIVE_THRESHOLD=4

# Comma-separated list of cities/regions to always allow. Empty = allow all.
# Example: LOCATION_FILTER=seattle,bellevue,redmond
LOCATION_FILTER=
# Comma-separated list of cities/regions to always drop. Empty = block none.
LOCATION_BLOCKLIST=

# Subdomain for the Built In regional site (e.g. 'seattle', 'nyc', 'austin').
# Default 'www' hits the nationwide site.
BUILTIN_SUBDOMAIN=www

# =============================================================================
# Company discovery (optional — Gemini-powered)
# =============================================================================
# Number of candidate companies for Gemini to suggest per run. Default 50.
# DISCOVER_CANDIDATE_COUNT=50
# Cache TTL for discovered companies (hours). Default 6.
# DISCOVER_TTL_HOURS=6

# =============================================================================
# Optional AI detection keys (voice-check pipeline)
# =============================================================================
# Sapling AI text detection: https://sapling.ai
# SAPLING_API_KEY=
# HuggingFace AI detection: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=

# =============================================================================
# Logging
# =============================================================================
# Log verbosity: debug | info | warn | error. Default info.
# LOG_LEVEL=info
# Days to keep refresh log files before pruning. Default 30.
# LOG_RETENTION_DAYS=30

# =============================================================================
# Docker worker (docker compose only)
# =============================================================================
# How often the worker container runs the full refresh pipeline (minutes). Default 30.
# REFRESH_INTERVAL_MINUTES=30
