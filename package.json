{
  "name": "job-search",
  "version": "1.0.0",
  "description": "Automated job search workflow",
  "type": "commonjs",
  "scripts": {
    "start": "node dashboard.js",
    "scrape": "set -a && . .env && set +a && node scraper.js",
    "pipeline": "set -a && . .env && set +a && node pipeline.js",
    "refresh": "node scripts/refresh.js",
    "help": "node scripts/npm-help.js",
    "daily": "node scripts/refresh.js",
    "reclassify": "set -a && . .env && set +a && node scripts/reclassify-complexity.js",
    "digest": "node scripts/send-email-digest.js",
    "sync-rejections": "node scripts/sync-rejection-emails.js",
    "retry-unscored": "set -a && . .env && set +a && node scripts/retry-unscored.js",
    "score": "set -a && . .env && set +a && node scorer.js",
    "resume": "node scripts/generate-resume.js",
    "test": "node --test",
    "validate-slugs": "node --env-file=.env scripts/validate-slugs.js",
    "validate-slugs:broken": "node --env-file=.env scripts/validate-slugs.js --broken-only",
    "test:contracts": "python3 -m unittest discover -s test_py",
    "setup": "sh scripts/setup.sh"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "imapflow": "^1.3.1",
    "nodemailer": "^6.9.0",
    "puppeteer-core": "^24.39.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
